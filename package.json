{
  "name": "guitar-arpeggio",
  "version": "0.1.0",
  "description": "Karplus-Strong 吉他合成器 + 分解和弦练习谱（纯 ESM，无打包器）",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "clean": "node scripts/clean.mjs dist build",
    "build": "node scripts/clean.mjs dist && tsc -p tsconfig.json",
    "build:dev": "node scripts/clean.mjs build && tsc -p tsconfig.dev.json",
    "watch": "tsc -p tsconfig.dev.json --watch",
    "dev": "npm run build:dev && node scripts/serve.mjs",
    "pretest": "npm run build",
    "test": "python tests/test_audio.py && node tests/worklet.test.mjs && node tests/resonator.test.mjs && node tests/engine.test.mjs && node tests/validate.test.mjs && node tests/ascii.test.mjs && node tests/ascii-parse.test.mjs && node tests/score.test.mjs",
    "prevalidate": "npm run build",
    "validate": "node scripts/validate.mjs",
    "prescore": "npm run build",
    "score": "node scripts/score.mjs",
    "precompile-score": "npm run build",
    "compile-score": "node scripts/compile-score.mjs",
    "prebook": "npm run build",
    "book": "node scripts/emit-book.mjs",
    "check": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "typescript": "^5.7.2"
  },
  "license": "MIT",
  "author": "caparisen",
  "keywords": [
    "guitar",
    "karplus-strong",
    "web-audio",
    "audioworklet",
    "tabs",
    "synthesizer"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/caparisen/guitar-arpeggio.git"
  },
  "homepage": "https://github.com/caparisen/guitar-arpeggio",
  "bugs": {
    "url": "https://github.com/caparisen/guitar-arpeggio/issues"
  }
}